# Browser-visible Supabase URL and publishable/anon key; rebuild after changing.
# Local setup fills blank keys automatically. Production uses your hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix service-role or AI credentials with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Set the exact HTTPS deployment origin in production; localhost is local only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_PROVIDER=openai-compatible
# DeepSeek example. Blank AI_API_KEY means AI 未配置; no simulated results.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
# Optional cost estimate, not a bill. Leave blank when prices are unknown.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
