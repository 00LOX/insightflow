{
  "name": "insightflow",
  "version": "0.1.0",
  "description": "A simple self-hosted RSS reader with Chinese AI explanations and private ideas",
  "main": "index.js",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit.test.ts tests/setup.test.ts",
    "test:e2e": "playwright test",
    "db:start": "node scripts/local-setup.mjs && docker compose up -d --wait db mail && node scripts/database.mjs sync-password && docker compose up -d && docker compose restart gateway",
    "db:test": "node --use-env-proxy --env-file=.env.local tests/integration.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "test:reading": "node --use-env-proxy --env-file=.env.local tests/reading.mjs",
    "test:rls": "node scripts/test-db.mjs",
    "db:verify": "node scripts/database.mjs verify",
    "db:backup": "node scripts/database.mjs backup",
    "package:source": "python3 scripts/package.py",
    "test:security": "node --use-env-proxy --env-file=.env.local tests/security-v01.mjs",
    "check:secrets": "python scripts/check-source-secrets.py --history --build",
    "audit:licenses": "node --use-env-proxy scripts/audit-licenses.mjs"
  },
  "keywords": [
    "rss",
    "ai",
    "reader",
    "deepseek",
    "self-hosted",
    "nextjs",
    "chinese"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "3.13.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
